{
  "expo": {
    "name": "PalmInsight",
    "slug": "palminsight",
    "version": "1.0.1",
    "orientation": "portrait",
    "scheme": "palminsight",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#F7F6FB",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#6d28d9"
    },
    "android": {
      "package": "live.bolddev.palminsight",
      "versionCode": 10,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#6d28d9"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "live.bolddev.palminsight"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "PalmInsight needs your photos to read a palm you've already captured.",
          "cameraPermission": "PalmInsight uses the camera to scan your palm."
        }
      ],
      "expo-asset",
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/Ionicons.ttf"
          ]
        }
      ],
      "@react-native-google-signin/google-signin"
    ]
  }
}
